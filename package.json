{
  "name": "cinnovawebsite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:seo:dist": "node scripts/audit-seo.mjs --dist",
    "generate:route-metadata": "node scripts/generate-route-metadata.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "validate:sitemap": "node scripts/generate-sitemap.mjs",
    "download:images": "node scripts/download-marketing-images.mjs",
    "download:blog-images": "node scripts/download-blog-images.mjs",
    "audit:blog-images": "node scripts/audit-blog-images.mjs",
    "audit:resource-images": "node scripts/audit-resource-images.mjs",
    "optimize:core-model": "node scripts/optimize-core-model.mjs",
    "scanner:validate": "node scripts/scanner-validate.mjs --provider sidecar --sidecar-dir data/scanner-validation/sidecars",
    "scanner:validate:live": "node scripts/scanner-validate.mjs --provider auto",
    "scanner:export": "node scripts/scanner-validation-export.mjs --format both",
    "setup:product-hero-posters": "node scripts/setup-product-hero-posters.mjs",
    "capture:realestate-hero-poster": "node scripts/capture-realestate-hero-poster.mjs",
    "validate:news": "node scripts/validate-news.mjs",
    "validate:blog": "node scripts/validate-blog.mjs",
    "test:news-route": "node scripts/test-news-route.mjs",
    "test:books-route": "node scripts/test-books-route.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "audit:sitemap-indexability": "node scripts/audit-sitemap-indexability.mjs",
    "test:monetization": "node scripts/test-monetization.mjs",
    "test:commerce": "node scripts/test-commerce.mjs",
    "test:subscriptions": "node scripts/test-subscriptions.mjs",
    "test:affiliate-foundation": "node scripts/test-affiliate-foundation.mjs",
    "test:partner-catalog": "node scripts/test-partner-catalog.mjs",
    "test:recommendations": "node scripts/test-recommendations.mjs",
    "test:revenue-activation": "node scripts/test-revenue-activation.mjs",
    "test:analytics": "node scripts/test-analytics.mjs",
    "test:social-utm": "node scripts/test-social-utm.mjs",
    "test:news-blog-diff": "node scripts/test-news-blog-differentiation.mjs",
    "test:editorial": "node scripts/test-editorial-pipeline.mjs",
    "test:editorial-live-research": "node scripts/test-editorial-live-research.mjs",
    "test:editorial-live-schedule": "node scripts/test-editorial-live-schedule.mjs",
    "test:editorial-corroboration": "node scripts/test-editorial-corroboration.mjs",
    "news:new": "node scripts/news-new.mjs",
    "news:publish": "node scripts/news-publish.mjs",
    "blog:new": "node scripts/blog-new.mjs",
    "blog:publish": "node scripts/blog-publish.mjs",
    "editorial:research": "node scripts/editorial-research.mjs",
    "editorial:discover": "node scripts/editorial-discover.mjs",
    "editorial:research-live": "node scripts/editorial-research-live.mjs",
    "editorial:daily": "node scripts/editorial-daily.mjs",
    "editorial:factcheck": "node scripts/editorial-factcheck.mjs",
    "editorial:review": "node scripts/editorial-review.mjs",
    "editorial:prepare-pr": "node scripts/editorial-prepare-pr.mjs",
    "build": "npm run audit:seo && npm run generate:sitemap && npm run audit:resource-images && npm run setup:product-hero-posters && vite build && npm run generate:route-metadata && npm run audit:seo:dist",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cinnova/motion": "file:packages/cinnova-motion",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@google/model-viewer": "^4.3.1",
    "@vercel/functions": "^3.7.5",
    "canvas": "^3.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "vite": "^8.0.12"
  }
}
