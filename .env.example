# CinNova Motion Library pilot — set to "true" to enable @cinnova/motion animations.
# When false or unset, no MotionProvider, presets, or motion CSS are loaded at runtime.
VITE_MOTION_ENABLED=false

# Google Analytics 4 Measurement ID
# Set this in your Vercel project environment variables for production builds.
# Format: G-XXXXXXXXXX
# Leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=G-CD944CHBK6

# Set to "true" to log GA4 init/page_view/event calls in the browser console AND
# tag every hit with debug_mode so it appears in GA4 Admin > DebugView.
# Leave "false" for production builds. A single browser can opt in without a
# rebuild by loading any page with ?ga_debug=1 (persists for that tab's session).
VITE_GA_DEBUG=false

# Admin/internal routes (/blog-admin, ?page=blog-manager, ?page=newsletter-admin).
# Default false: these resolve to NotFound so they are unreachable in production.
# For local development you may set VITE_ENABLE_ADMIN_ROUTES=true in .env.local.
# Leave this false/unset in production unless the admin pages are protected by
# real authentication (this flag is a route gate, not an auth mechanism).
# Phase 11.4A: no Partner Admin UI — affiliate config is registry + env + docs only.
VITE_ENABLE_ADMIN_ROUTES=false

# Phase 11.4A — Affiliate / partner program master switch.
# Default false/unset: no PartnerOutboundLink destinations render.
# Do not enable in production until partners are verified and disclosures reviewed.
# VITE_AFFILIATES_ENABLED=false

# Optional partner destination URLs (https only). Leave unset until activation.
# Never commit real production affiliate IDs or tracked URLs to git.
# VITE_AFFILIATE_URL_NOTION=
# VITE_AFFILIATE_CAMPAIGN_NOTION=
# VITE_AFFILIATE_URL_CANVA=
# VITE_AFFILIATE_CAMPAIGN_CANVA=
# VITE_AFFILIATE_URL_GRAMMARLY=
# VITE_AFFILIATE_CAMPAIGN_GRAMMARLY=
# VITE_AFFILIATE_URL_BIGGERPOCKETS=
# VITE_AFFILIATE_CAMPAIGN_BIGGERPOCKETS=
# VITE_AFFILIATE_URL_DEALCHECK=
# VITE_AFFILIATE_CAMPAIGN_DEALCHECK=
# VITE_AFFILIATE_URL_AMAZON=
# VITE_AFFILIATE_CAMPAIGN_AMAZON=

# ── Phase M2 payments (server-side only — never commit real secrets) ─────────
# CINNOVA_PAYMENTS_MODE=UNCONFIGURED
# Values: UNCONFIGURED | TEST | LIVE_DISABLED | LIVE
# TEST requires sk_test_ secret. LIVE requires CINNOVA_LIVE_PAYMENTS_APPROVED=true + sk_live_.
# CINNOVA_LIVE_PAYMENTS_APPROVED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TAX_ENABLED=false
# Client publishable key only (pk_test_ / pk_live_) — never sk_ keys in VITE_*:
# VITE_STRIPE_PUBLISHABLE_KEY=

# Lead-capture email notifications (server-side only; used by /api/subscribe and
# /api/contact). Set these in the Vercel project environment variables — never
# commit real values. If any are missing, the endpoints return a safe 503
# ("Lead email service not configured") and the client keeps its localStorage
# fallback. Uses Resend's HTTP API (https://resend.com).
# RESEND_API_KEY=
# LEAD_NOTIFY_TO=owner@example.com
# LEAD_FROM_EMAIL=leads@yourdomain.com

# PoisonGuard scanner inference (internal validation CLI — not bundled in frontend)
# SCANNER_API_URL=https://your-scanner-service.example.com/v1/identify
# SCANNER_API_KEY=
# OPENAI_API_KEY=
# SCANNER_OPENAI_MODEL=gpt-4o-mini
# SCANNER_INFERENCE_PROVIDER=auto
# SCANNER_SIDECAR_DIR=data/scanner-validation/sidecars
