{
  "name": "@cinnova/motion",
  "version": "1.0.0",
  "description": "CinNova Motion Library — reusable animation infrastructure for all CinNova products",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./motion.css": "./src/motion/motion.css",
    "./hooks": {
      "import": "./src/motion/hooks/index.ts",
      "types": "./src/motion/hooks/index.ts"
    },
    "./presets": {
      "import": "./src/motion/presets/index.ts",
      "types": "./src/motion/presets/index.ts"
    },
    "./kiddo": {
      "import": "./src/motion/kiddo/index.ts",
      "types": "./src/motion/kiddo/index.ts"
    },
    "./nightmare": {
      "import": "./src/motion/nightmare/index.ts",
      "types": "./src/motion/nightmare/index.ts"
    },
    "./realestate": {
      "import": "./src/motion/realestate/index.ts",
      "types": "./src/motion/realestate/index.ts"
    },
    "./techmate": {
      "import": "./src/motion/techmate/index.ts",
      "types": "./src/motion/techmate/index.ts"
    },
    "./poisonguard": {
      "import": "./src/motion/poisonguard/index.ts",
      "types": "./src/motion/poisonguard/index.ts"
    },
    "./studynest": {
      "import": "./src/motion/studynest/index.ts",
      "types": "./src/motion/studynest/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:preview": "vite preview --config showcase/vite.config.ts",
    "showcase:typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.6.3",
    "vite": "^8.0.12"
  },
  "keywords": [
    "cinnova",
    "motion",
    "animation",
    "react",
    "accessibility"
  ],
  "license": "UNLICENSED",
  "private": true
}
